<Project Sdk="Microsoft.NET.Sdk">
  <!-- Events test probe (dev only, never shipped): its own small mod that rides on a proto/events dev copy of the faction
       (Id JigglyPanda.PandabornFactionsDev, built by proto/events/build.ps1), compiled against that copy's own
       Pandaborn.Core/Specs/Festival/Flowering (copied to $(RefDir) as .dll). The modules themselves load through the
       copy's bootstrap; nothing here is a module. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PandabornProtoEvents</AssemblyName>
    <RootNamespace>Pandaborn.Events</RootNamespace>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ModOut Condition="'$(ModOut)' == ''">E:\PandabornDev\build\proto\events-probe</ModOut>
    <RefDir Condition="'$(RefDir)' == ''">E:\PandabornDev\build\obj\proto-events-ref</RefDir>
    <OutputPath>$(ModOut)\Scripts\</OutputPath>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Timberborn\Timberborn_Data\Managed</GameManaged>
    <NoWarn>CS1701;CS1702;MSB3277;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="IsExternalInit.cs" />
    <Reference Include="$(GameManaged)\Timberborn.*.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\Bindito.Core.dll" Private="false" />
    <Reference Include="$(GameManaged)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(GameManaged)\System.Collections.Immutable.dll" Private="false" />
    <Reference Include="$(RefDir)\Pandaborn.Core.dll" Private="false" />
    <Reference Include="$(RefDir)\Pandaborn.Specs.dll" Private="false" />
    <Reference Include="$(RefDir)\Pandaborn.Festival.dll" Private="false" />
    <Reference Include="$(RefDir)\Pandaborn.Flowering.dll" Private="false" />
  </ItemGroup>
</Project>
