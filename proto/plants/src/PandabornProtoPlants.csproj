<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plants prototype: the plant lab (forces plant states for filming). Dev only, never shipped.
       Build: proto/plants/build.ps1. Output: E:\PandabornDev\build\proto\plants\Scripts -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PandabornProtoPlants</AssemblyName>
    <RootNamespace>Pandaborn.PlantsProto</RootNamespace>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ModOut Condition="'$(ModOut)' == ''">E:\PandabornDev\build\proto\plants</ModOut>
    <OutputPath>$(ModOut)\Scripts\</OutputPath>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Timberborn\Timberborn_Data\Managed</GameManaged>
    <NoWarn>CS1701;CS1702;MSB3277;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameManaged)\Timberborn.*.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\Bindito.Core.dll" Private="false" />
    <Reference Include="$(GameManaged)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(GameManaged)\System.Collections.Immutable.dll" Private="false" />
  </ItemGroup>
</Project>
