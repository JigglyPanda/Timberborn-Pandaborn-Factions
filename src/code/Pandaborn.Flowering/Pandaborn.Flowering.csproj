<Project Sdk="Microsoft.NET.Sdk">
  <!-- Feature module: the Great Flowering (Modules\Pandaborn.Flowering.bin). See FEATURE.md and docs/tech/events.md.
       Not in Pandaborn.Code.sln or modules.txt yet: it does nothing until the catalogue carries its data (the requests in
       docs/tech/events.md); wire it in together with that data. Build alone:
         dotnet build src\code\Pandaborn.Flowering\Pandaborn.Flowering.csproj -c Release -p:ModOut=<folder>
       Dev test build: proto/events/build.ps1. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Pandaborn.Flowering</AssemblyName>
    <RootNamespace>Pandaborn.Flowering</RootNamespace>
    <PandabornKind>Feature</PandabornKind>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameManaged)\Timberborn.*.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.UIElementsModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\Bindito.Core.dll" Private="false" />
    <Reference Include="$(GameManaged)\System.Collections.Immutable.dll" Private="false" />
    <ProjectReference Include="..\Pandaborn.Specs\Pandaborn.Specs.csproj" Private="false" />
    <ProjectReference Include="..\Pandaborn.Core\Pandaborn.Core.csproj" Private="false" />
  </ItemGroup>
</Project>
