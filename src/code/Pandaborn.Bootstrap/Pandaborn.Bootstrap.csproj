<Project Sdk="Microsoft.NET.Sdk">
  <!-- The only assembly the game loads by itself (Scripts\Pandaborn.Bootstrap.dll). It must reference nothing but the
       mod-starter interface and Debug.Log, so that it can never fail to load. See src/code/README.md. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Pandaborn.Bootstrap</AssemblyName>
    <RootNamespace>Pandaborn.Bootstrap</RootNamespace>
    <PandabornKind>Bootstrap</PandabornKind>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameManaged)\Timberborn.ModManagerScene.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="CopyModuleManifest" AfterTargets="PandabornPackage">
    <Copy SourceFiles="$(CodeRoot)modules.txt" DestinationFolder="$(ModOut)\Modules" />
  </Target>
  <!-- The game version this build was made against (the pin the build refuses to run without), for the bootstrap's
       "built for X, running Y" log line. -->
  <Target Name="StampGameVersion" AfterTargets="PandabornPackage">
    <PropertyGroup>
      <PinFile>$(CodeRoot)../../catalogue/vanilla.pin.json</PinFile>
      <BuiltForGame Condition="Exists('$(PinFile)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(PinFile)')), 'gameVersion[^0-9]*([0-9][0-9A-Za-z.]*)').Groups[1].Value)</BuiltForGame>
    </PropertyGroup>
    <WriteLinesToFile Condition="'$(BuiltForGame)' != ''" File="$(ModOut)\Scripts\Pandaborn.built-for.txt" Lines="$(BuiltForGame)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Message Importance="high" Text="Pandaborn.Bootstrap: built for game version '$(BuiltForGame)'" />
  </Target>
</Project>
