<Project Sdk="Microsoft.NET.Sdk">
  <!-- Every spec record of the mod (Scripts\Pandaborn.Specs.bin). Always loaded, whatever features are on, so blueprint
       data that names our specs always deserialises. Only references the blueprint system. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Pandaborn.Specs</AssemblyName>
    <RootNamespace>Pandaborn.Specs</RootNamespace>
    <PandabornKind>Core</PandabornKind>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameManaged)\Timberborn.BlueprintSystem.dll" Private="false" />
    <Reference Include="$(GameManaged)\System.Collections.Immutable.dll" Private="false" />
    <!-- Vector3Int in the water specs' cell lists -->
    <Reference Include="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
</Project>
