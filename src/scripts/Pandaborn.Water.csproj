<Project Sdk="Microsoft.NET.Sdk">
  <!-- Water toolkit components (flume segment, dew limiter). For now built into the dev prototype mod
       proto/water (manifest Id JigglyPanda.PandabornProtoWater), not the shipped mod.
       Build: dotnet build src/scripts -c Release
       Output: E:\PandabornDev\build\proto\water (the whole prototype mod: proto/water/mod plus Scripts\Pandaborn.Water.dll).
       No Harmony, no reference to other mods. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Pandaborn.Water</AssemblyName>
    <RootNamespace>Pandaborn.Water</RootNamespace>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ModOut Condition="'$(ModOut)' == ''">E:\PandabornDev\build\proto\water</ModOut>
    <ModSource Condition="'$(ModSource)' == ''">$(MSBuildThisFileDirectory)..\..\proto\water\mod</ModSource>
    <OutputPath>$(ModOut)\Scripts\</OutputPath>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Timberborn\Timberborn_Data\Managed</GameManaged>
    <NoWarn>CS1701;CS1702;MSB3277;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameManaged)\Timberborn.*.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\Bindito.Core.dll" Private="false" />
    <Reference Include="$(GameManaged)\System.Collections.Immutable.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <ModFiles Include="$(ModSource)\**\*" />
  </ItemGroup>
  <!-- mirror the prototype's data into the build folder (stale data files are removed first) -->
  <Target Name="CopyModData" AfterTargets="Build">
    <ItemGroup>
      <StaleData Include="$(ModOut)\**\*" Exclude="$(ModOut)\Scripts\**" />
    </ItemGroup>
    <Delete Files="@(StaleData)" />
    <Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(ModOut)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
